.dish-art {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: linear-gradient(140deg, #F4E4D1 0%, #EED6BE 100%);
}

.art-img {
  width: 100%;
  height: 100%;
}

.art-css {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.art-css::before {
  content: "";
  position: absolute;
  width: 78%;
  height: 78%;
  border-radius: 50%;
  background: rgba(255, 252, 247, 0.38);
}

.plate {
  position: relative;
  width: 70%;
  height: 70%;
  border-radius: 50%;
  background: #FCF7EC;
  box-shadow: inset 0 0 0 8rpx rgba(232, 201, 168, 0.4), 0 6rpx 16rpx rgba(120, 80, 50, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.food {
  width: 64%;
  height: 64%;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 -4rpx 10rpx rgba(120, 70, 40, 0.12);
}

.glyph {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(58, 48, 42, 0.65);
  line-height: 1;
}

.tone-0 .food {
  background: #E8C9A8;
}

.tone-1 .food {
  background: #E3B16B;
}

.tone-2 .food {
  background: #A6C493;
}

.tone-3 .food {
  background: #E29274;
}

.tone-1 {
  background: linear-gradient(140deg, #F5E6CE 0%, #EBD3AA 100%);
}

.tone-2 {
  background: linear-gradient(140deg, #E9EDD9 0%, #D8E1C6 100%);
}

.tone-3 {
  background: linear-gradient(140deg, #F5E1D6 0%, #EFCDBC 100%);
}
