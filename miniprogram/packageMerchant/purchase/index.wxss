.purchase-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
  background: var(--bg);
}

.purchase-head {
  padding: 6rpx 4rpx 20rpx;
}

.ph-title {
  font-size: var(--fs-block);
  font-weight: 600;
  line-height: 1.3;
}

.ph-sub {
  margin-top: 5rpx;
  font-size: var(--fs-tiny);
  color: var(--ink-3);
}

.date-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 14rpx;
  margin-bottom: 18rpx;
}

.date-nav {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-2);
}

.date-nav:active {
  background: var(--paper);
}

.chevron.left {
  border: none;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(45deg);
}

.chevron.right {
  border: none;
  border-right: 4rpx solid currentColor;
  border-top: 4rpx solid currentColor;
  transform: rotate(45deg);
  width: 16rpx;
  height: 16rpx;
}

.date-picker {
  flex: 1;
  text-align: center;
}

.date-value {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: var(--fs-card);
  font-weight: 600;
}

.today-tag {
  padding: 2rpx 12rpx;
  border-radius: var(--r-pill);
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-size: var(--fs-micro);
  font-weight: 500;
}

.purchase-hero {
  padding: 30rpx;
  border-radius: var(--r-md);
  background: linear-gradient(125deg, var(--hero-grad-a), var(--hero-grad-b));
  margin-bottom: 20rpx;
}

.hero-title {
  font-size: var(--fs-block);
  font-weight: 600;
  line-height: 1.3;
}

.hero-desc {
  margin-top: 6rpx;
  font-size: var(--fs-tiny);
  line-height: 1.5;
  color: var(--ink-2);
}

.counts {
  display: flex;
  gap: 36rpx;
  margin-top: 22rpx;
}

.counts .num {
  font-size: var(--fs-stat);
  font-weight: 600;
  color: var(--brand-deep);
  line-height: 1.1;
}

.counts .unit {
  margin-left: 8rpx;
  font-size: var(--fs-weak);
  color: var(--ink-3);
}

.ing-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx;
  background: var(--surface);
  border: 1rpx solid var(--line-2);
  border-radius: var(--r-md);
  margin-bottom: 14rpx;
}

.ing-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: var(--brand-soft);
  color: var(--brand-deep);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-sub);
  font-weight: 600;
  flex: none;
}

.ing-main {
  flex: 1;
  min-width: 0;
}

.iname {
  font-size: var(--fs-sub);
  font-weight: 500;
}

.isub {
  margin-top: 4rpx;
  font-size: var(--fs-weak);
  line-height: 1.45;
  color: var(--ink-3);
}

.orders {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
  margin-left: auto;
  max-width: 220rpx;
  flex: none;
}

.orders .o {
  font-size: var(--fs-micro);
  color: var(--ink-2);
  background: var(--order-chip-bg);
  border-radius: 8rpx;
  padding: 5rpx 9rpx;
  white-space: nowrap;
}

.purchase-note {
  margin: 22rpx 4rpx 40rpx;
  font-size: var(--fs-weak);
  line-height: 1.65;
  color: var(--ink-3);
}
