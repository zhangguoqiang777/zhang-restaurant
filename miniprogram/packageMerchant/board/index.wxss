.board-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 0;
  background: var(--bg);
}

.board-head {
  padding: 6rpx 4rpx 20rpx;
}

.bh-title {
  font-size: var(--fs-block);
  font-weight: 600;
  line-height: 1.3;
}

.bh-sub {
  margin-top: 5rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}

.date-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 14rpx;
  margin-bottom: 18rpx;
}

.date-nav {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-2);
}

.date-nav:active {
  background: var(--paper);
}

.chevron.left {
  border: none;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(45deg);
}

.chevron.right {
  border: none;
  border-right: 4rpx solid currentColor;
  border-top: 4rpx solid currentColor;
  transform: rotate(45deg);
  width: 16rpx;
  height: 16rpx;
}

.date-picker {
  flex: 1;
  text-align: center;
}

.date-value {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.today-tag {
  padding: 2rpx 12rpx;
  border-radius: var(--r-pill);
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-size: 18rpx;
  font-weight: 500;
}

.stat-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 8rpx;
}

.stat-card {
  flex: 1;
  padding: 20rpx 18rpx;
  border-radius: var(--r-md);
  border: 1rpx solid transparent;
}

.stat-card.pending {
  background: var(--amber-bg);
}

.stat-card.cooking {
  background: var(--brand-soft);
}

.stat-card.completed {
  background: var(--green-bg);
}

.stat-num {
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.15;
}

.stat-card.pending .stat-num {
  color: var(--amber);
}

.stat-card.cooking .stat-num {
  color: var(--brand-deep);
}

.stat-card.completed .stat-num {
  color: var(--green);
}

.stat-label {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--ink-2);
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 34rpx 4rpx 16rpx;
}

.gh-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.gh-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.gh-dot.pending {
  background: var(--amber);
}

.gh-dot.cooking {
  background: var(--brand);
}

.gh-dot.completed {
  background: var(--green);
}

.gh-title {
  font-size: 28rpx;
  font-weight: 600;
}

.gh-count {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  background: var(--seg-bg);
  color: var(--ink-2);
  font-size: 19rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gorder {
  margin-bottom: 18rpx;
}

.customer-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 0 16rpx;
  border-bottom: 1rpx solid var(--line-2);
}

.customer-main {
  flex: 1;
  min-width: 0;
}

.customer-name {
  font-size: 25rpx;
  font-weight: 600;
}

.g-items {
  padding: 10rpx 0 6rpx;
}

.g-item {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  padding: 7rpx 0;
  font-size: 25rpx;
}

.gi-name {
  color: var(--ink-2);
}

.gi-qty {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--brand-deep);
  flex: none;
}

.remark-mini {
  display: flex;
  gap: 12rpx;
  margin-top: 10rpx;
  padding: 14rpx 16rpx;
  border-radius: var(--r-sm);
  background: #FBF2E6;
}

.rm-label {
  font-size: 20rpx;
  color: var(--amber);
  font-weight: 600;
  flex: none;
}

.rm-text {
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--ink-2);
  flex: 1;
}

.gfoot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-top: 16rpx;
  margin-top: 14rpx;
  border-top: 1rpx solid var(--line-2);
}

.gfoot-note {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  color: var(--ink-3);
}

.g-actions {
  display: flex;
  gap: 12rpx;
  flex: none;
}

.g-actions .mini-btn {
  height: 56rpx;
  padding: 0 22rpx;
}
