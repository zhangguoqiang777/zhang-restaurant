.ingredients-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
  background: var(--bg);
}

.ing-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 6rpx 4rpx 22rpx;
}

.ih-title {
  font-size: var(--fs-block);
  font-weight: 600;
  line-height: 1.3;
}

.ih-sub {
  margin-top: 5rpx;
  font-size: var(--fs-tiny);
  color: var(--ink-3);
}

.add-btn {
  height: 68rpx;
  padding: 0 24rpx;
  flex: none;
}

.ing-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx;
  background: var(--surface);
  border: 1rpx solid var(--line-2);
  border-radius: var(--r-md);
  margin-bottom: 14rpx;
  box-shadow: 0 4rpx 14rpx rgba(92, 62, 42, 0.05);
}

.ing-item.off {
  opacity: 0.66;
}

.ing-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: var(--brand-soft);
  color: var(--brand-deep);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-sub);
  font-weight: 600;
  flex: none;
}

.ing-main {
  flex: 1;
  min-width: 0;
}

.ing-name {
  font-size: var(--fs-sub);
  font-weight: 500;
}

.ing-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: none;
}

.ing-actions .mini-btn {
  height: 52rpx;
  padding: 0 18rpx;
  font-size: var(--fs-tiny);
}

.ing-note {
  margin: 22rpx 4rpx 20rpx;
  font-size: var(--fs-weak);
  line-height: 1.65;
  color: var(--ink-3);
}
