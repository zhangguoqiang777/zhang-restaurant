.dishes-page {
  min-height: 100vh;
  padding: 20rpx 32rpx 0;
  background: var(--bg);
}

.toolbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 0 6rpx;
}

.toolbar .search-box {
  flex: 1;
  min-width: 0;
}

.clear-btn {
  width: 40rpx;
  text-align: center;
  font-size: 32rpx;
  line-height: 1;
  color: var(--ink-3);
}

.add-btn {
  height: 76rpx;
  padding: 0 26rpx;
  font-size: var(--fs-sub);
  flex: none;
}

.manage-links {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 4rpx 2rpx 16rpx;
}

.ml-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--fs-tiny);
  color: var(--brand-deep);
}

.ml-arrow {
  width: 12rpx;
  height: 12rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(45deg) translateY(-3rpx);
  transition: transform 0.2s;
}

.ml-arrow.up {
  transform: rotate(-135deg) translateY(-3rpx);
}

.ml-chevron {
  width: 12rpx;
  height: 12rpx;
  border-right: 3rpx solid currentColor;
  border-top: 3rpx solid currentColor;
  transform: rotate(45deg);
}

.category-panel {
  padding: 22rpx;
  margin-bottom: 18rpx;
}

.cp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--line-2);
}

.cp-title {
  font-size: var(--fs-sub);
  font-weight: 600;
}

.cat-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}

.cat-main {
  flex: 1;
  min-width: 0;
}

.cat-name {
  font-size: var(--fs-sub);
  font-weight: 500;
}

.cat-name.off {
  color: var(--ink-3);
  text-decoration: line-through;
}

.cat-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: none;
}

.cat-move {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--search-bg);
  color: var(--ink-2);
  font-size: var(--fs-meta);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cat-move.disabled {
  opacity: 0.35;
}

.cat-actions .mini-btn {
  height: 48rpx;
  padding: 0 16rpx;
  font-size: var(--fs-tiny);
}

.manage-item {
  display: flex;
  gap: 18rpx;
  align-items: center;
  padding: 20rpx;
  background: var(--surface);
  border: 1rpx solid var(--line-2);
  border-radius: var(--r-md);
  margin-bottom: 14rpx;
  box-shadow: 0 4rpx 14rpx rgba(92, 62, 42, 0.05);
}

.manage-item.off {
  opacity: 0.68;
}

.manage-item .art-frame {
  width: 104rpx;
  height: 104rpx;
}

.mi-main {
  flex: 1;
  min-width: 0;
}

.mi-name {
  font-size: var(--fs-sub);
  font-weight: 500;
}

.mi-sub {
  margin-top: 4rpx;
  font-size: var(--fs-weak);
  line-height: 1.45;
  color: var(--ink-3);
}

.purchase-note {
  margin: 20rpx 4rpx 40rpx;
  font-size: var(--fs-weak);
  line-height: 1.65;
  color: var(--ink-3);
}
