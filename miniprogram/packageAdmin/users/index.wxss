.admin-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
  background: var(--bg);
}

.admin-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx;
  border-radius: var(--r-md);
  background: linear-gradient(125deg, var(--hero-grad-2a), var(--hero-grad-2b));
  margin-bottom: 20rpx;
}

.ah-main {
  flex: 1;
  min-width: 0;
}

.ah-title {
  font-size: var(--fs-nav);
  font-weight: 600;
  line-height: 1.3;
}

.ah-desc {
  margin-top: 6rpx;
  font-size: var(--fs-tiny);
  line-height: 1.55;
  color: var(--ink-2);
}

.admin-badge {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: var(--r-pill);
  background: rgba(255, 252, 247, 0.8);
  border: 1rpx solid rgba(192, 96, 60, 0.18);
  color: var(--brand-deep);
  font-size: var(--fs-weak);
  font-weight: 500;
  flex: none;
}

.admin-search {
  margin-bottom: 14rpx;
}

.clear-btn {
  width: 40rpx;
  text-align: center;
  font-size: 32rpx;
  line-height: 1;
  color: var(--ink-3);
}

.list-count {
  padding: 4rpx 4rpx 14rpx;
  font-size: var(--fs-weak);
  color: var(--ink-3);
}

.user-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx;
  background: var(--surface);
  border: 1rpx solid var(--line-2);
  border-radius: var(--r-md);
  margin-bottom: 14rpx;
  box-shadow: 0 4rpx 14rpx rgba(92, 62, 42, 0.05);
}

.user-row .meta {
  flex: 1;
  min-width: 0;
}

.user-row .meta .n {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: var(--fs-sub);
  font-weight: 500;
}

.me-tag {
  padding: 1rpx 10rpx;
  border-radius: 6rpx;
  background: var(--brand);
  color: var(--surface);
  font-size: var(--fs-micro);
  font-weight: 500;
}

.super-tag {
  padding: 1rpx 10rpx;
  border-radius: 6rpx;
  background: var(--green-bg);
  color: var(--green);
  font-size: var(--fs-micro);
  font-weight: 500;
}

.user-row .meta .id {
  margin-top: 5rpx;
  font-size: var(--fs-weak);
  color: var(--ink-3);
  letter-spacing: 0.01em;
}

.user-row .meta .last {
  margin-top: 4rpx;
  font-size: var(--fs-weak);
  color: var(--ink-3);
}

.admin-note {
  display: flex;
  gap: 12rpx;
  margin: 24rpx 4rpx 32rpx;
  font-size: var(--fs-weak);
  line-height: 1.65;
  color: var(--ink-3);
}
