{
  "compilerOptions": {
    "target": "ES2017",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": false,
    "lib": ["ES2017"],
    "types": [],
    "typeRoots": ["./typings"]
  },
  "include": ["./**/*.ts", "./typings/**/*.d.ts"],
  "exclude": ["node_modules"]
}
