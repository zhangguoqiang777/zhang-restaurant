.entry {
  min-height: 100vh;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}

.hero {
  padding: 28rpx 44rpx 52rpx;
  background: linear-gradient(158deg, #F8EDE0 0%, #F4EEE5 62%, #F4EEE5 100%);
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 44rpx;
}

.brand-mark {
  position: relative;
  width: 48rpx;
  height: 44rpx;
}

.brand-mark .bowl {
  position: absolute;
  left: 2rpx;
  right: 2rpx;
  bottom: 2rpx;
  height: 24rpx;
  border: 3rpx solid var(--brand-deep);
  border-top: 0;
  border-radius: 0 0 24rpx 24rpx;
}

.brand-mark .steam {
  position: absolute;
  top: 4rpx;
  width: 12rpx;
  height: 14rpx;
  border-left: 3rpx solid rgba(142, 69, 41, 0.55);
  border-radius: 8rpx;
}

.brand-mark .steam-a {
  left: 14rpx;
}

.brand-mark .steam-b {
  left: 28rpx;
  top: 12rpx;
  height: 10rpx;
}

.brand-name {
  font-size: 24rpx;
  letter-spacing: 0.12em;
  color: var(--brand-deep);
  font-weight: 600;
}

.hero-title {
  font-size: var(--fs-display);
  line-height: 1.32;
  font-weight: 600;
  letter-spacing: -0.01em;
  color: var(--ink);
}

.hero-title text,
.hero-sub text {
  display: block;
}

.hero-sub {
  margin-top: 22rpx;
  font-size: var(--fs-card);
  line-height: 1.65;
  color: var(--ink-2);
}

.saved-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 28rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}

.lock-ic {
  position: relative;
  width: 20rpx;
  height: 18rpx;
  border: 3rpx solid var(--ink-3);
  border-radius: 4rpx;
  margin-top: 3rpx;
}

.lock-ic::before {
  content: "";
  position: absolute;
  left: 3rpx;
  top: -12rpx;
  width: 8rpx;
  height: 10rpx;
  border: 3rpx solid var(--ink-3);
  border-bottom: 0;
  border-radius: 8rpx 8rpx 0 0;
}

.body {
  padding: 8rpx 32rpx 0;
}

.role-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 20rpx;
  background: var(--surface);
  border: 2rpx solid transparent;
  border-radius: var(--r-md);
  box-shadow: 0 6rpx 22rpx rgba(92, 62, 42, 0.06);
  transition: border-color 0.15s;
}

.role-card.selected {
  border-color: var(--brand);
  box-shadow: 0 10rpx 28rpx rgba(192, 96, 60, 0.14);
}

.role-ic {
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  flex: none;
}

.role-ic.tone-brand {
  background: var(--brand-soft);
  color: var(--brand-deep);
}

.role-ic.tone-dark {
  background: #EEE7DE;
  color: #5A4A40;
}

.role-ic.tone-green {
  background: var(--green-bg);
  color: var(--green);
}

.role-main {
  flex: 1;
  min-width: 0;
}

.role-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.role-desc {
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--ink-3);
}

.radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.radio.on {
  border-color: var(--brand);
}

.radio-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: transparent;
}

.radio.on .radio-dot {
  background: var(--brand);
}

.role-note {
  display: flex;
  gap: 12rpx;
  margin: 20rpx 8rpx 0;
  font-size: 21rpx;
  line-height: 1.65;
  color: var(--ink-3);
}

.entry-foot {
  margin-top: 36rpx;
  text-align: center;
  font-size: 21rpx;
  color: #B6A697;
}

.arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 4rpx solid currentColor;
  border-right: 4rpx solid currentColor;
  transform: rotate(45deg);
  margin-left: 2rpx;
}

.error-card {
  padding: 40rpx 32rpx 32rpx;
  margin-top: 16rpx;
}

.error-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.error-desc {
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--rose);
  margin-bottom: 28rpx;
}

.error-tip {
  margin-top: 22rpx;
}
