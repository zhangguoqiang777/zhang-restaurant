.manage-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 0;
  background: var(--bg);
}

.manage-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 30rpx 28rpx;
  border-radius: var(--r-md);
  background: linear-gradient(125deg, var(--hero-grad-a), var(--hero-grad-b));
  margin-bottom: 8rpx;
}

.mh-main {
  flex: 1;
  min-width: 0;
}

.mh-kicker {
  font-size: 20rpx;
  letter-spacing: 0.08em;
  color: var(--brand-deep);
}

.mh-title {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.3;
}

.mh-desc {
  margin-top: 6rpx;
  font-size: 21rpx;
  line-height: 1.55;
  color: var(--ink-2);
}

.mh-badge {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: var(--r-pill);
  background: rgba(255, 252, 247, 0.8);
  border: 1rpx solid rgba(192, 96, 60, 0.18);
  color: var(--brand-deep);
  font-size: 19rpx;
  font-weight: 500;
  flex: none;
}

.entry-list {
  padding: 4rpx 24rpx;
}

.entry-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
}

.entry-row + .entry-row {
  border-top: 1rpx solid var(--line-2);
}

.er-ic {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 600;
  flex: none;
}

.er-ic.tone-brand {
  background: var(--brand-soft);
  color: var(--brand-deep);
}

.er-ic.tone-dark {
  background: #EEE7DE;
  color: #5A4A40;
}

.er-ic.tone-green {
  background: var(--green-bg);
  color: var(--green);
}

.er-ic.tone-amber {
  background: var(--amber-bg);
  color: var(--amber);
}

.er-main {
  flex: 1;
  min-width: 0;
}

.er-title {
  font-size: 28rpx;
  font-weight: 500;
}

.er-desc {
  margin-top: 4rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: var(--ink-3);
}

.manage-note {
  margin: 26rpx 4rpx 20rpx;
  font-size: 20rpx;
  line-height: 1.65;
  color: var(--ink-3);
}
