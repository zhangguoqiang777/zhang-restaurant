.profile-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 0;
  background: var(--bg);
}

.profile-hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 28rpx;
  border-radius: var(--r-lg);
  background: linear-gradient(140deg, #F8EBDD 0%, #FBF4EA 70%);
  border: 1rpx solid var(--line-2);
}

.avatar.big {
  width: 112rpx;
  height: 112rpx;
  font-size: 42rpx;
  background: #FFFFFF;
  color: var(--brand-deep);
  box-shadow: 0 6rpx 18rpx rgba(120, 70, 40, 0.1);
}

.ph-main {
  flex: 1;
  min-width: 0;
}

.ph-name {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.3;
}

.ph-id {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}

.ph-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.role-grid {
  display: flex;
  gap: 14rpx;
}

.role-tile {
  position: relative;
  flex: 1;
  min-width: 0;
  padding: 22rpx 14rpx 20rpx;
  border-radius: var(--r-md);
  background: var(--surface);
  border: 2rpx solid transparent;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(92, 62, 42, 0.05);
}

.role-tile.on {
  border-color: var(--brand);
  background: #FFFDFB;
}

.rt-glyph {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  margin: 0 auto 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
}

.rt-glyph.tone-brand {
  background: var(--brand-soft);
  color: var(--brand-deep);
}

.rt-glyph.tone-dark {
  background: #EEE7DE;
  color: #5A4A40;
}

.rt-glyph.tone-green {
  background: var(--green-bg);
  color: var(--green);
}

.rt-title {
  font-size: 25rpx;
  font-weight: 600;
}

.rt-desc {
  margin-top: 4rpx;
  font-size: 18rpx;
  line-height: 1.45;
  color: var(--ink-3);
}

.rt-current {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  padding: 2rpx 10rpx;
  border-radius: var(--r-pill);
  background: var(--brand);
  color: #FFFFFF;
  font-size: 16rpx;
  line-height: 1.6;
}

.menu-list {
  padding: 4rpx 24rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
}

.menu-row + .menu-row {
  border-top: 1rpx solid var(--line-2);
}

.mr-ic {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  flex: none;
}

.mr-ic.tone-brand {
  background: var(--brand-soft);
  color: var(--brand-deep);
}

.mr-ic.tone-dark {
  background: #EEE7DE;
  color: #5A4A40;
}

.mr-ic.tone-green {
  background: var(--green-bg);
  color: var(--green);
}

.mr-ic.tone-amber {
  background: var(--amber-bg);
  color: var(--amber);
}

.mr-main {
  flex: 1;
  min-width: 0;
}

.mr-title {
  font-size: 27rpx;
  font-weight: 500;
}

.mr-desc {
  margin-top: 3rpx;
  font-size: 20rpx;
  color: var(--ink-3);
  line-height: 1.45;
}

.chevron.right {
  border: none;
  border-right: 3rpx solid var(--ink-3);
  border-top: 3rpx solid var(--ink-3);
  transform: rotate(45deg);
  width: 14rpx;
  height: 14rpx;
  flex: none;
}

.url-value {
  max-width: 300rpx;
  font-size: 19rpx;
  color: var(--brand-deep);
  text-align: right;
  word-break: break-all;
  flex: none;
}

.about-card {
  margin: 30rpx 4rpx 0;
  padding: 26rpx 24rpx;
  border-radius: var(--r-md);
  background: var(--paper);
  border: 1rpx dashed var(--line);
}

.about-title {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--ink-2);
  margin-bottom: 10rpx;
}

.about-desc {
  font-size: 20rpx;
  line-height: 1.65;
  color: var(--ink-3);
}

.about-desc + .about-desc {
  margin-top: 8rpx;
}
