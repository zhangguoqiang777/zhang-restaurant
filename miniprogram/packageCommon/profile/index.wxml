<view class="profile-page page-with-tab">
  <view class="profile-hero">
    <view class="avatar big">{{avatarChar}}</view>
    <view class="ph-main">
      <view class="ph-name">{{user.nickname || '微信用户'}}</view>
      <view class="ph-id">用户 #{{user.id}}<text wx:if="{{openidMasked}}"> · {{openidMasked}}</text></view>
      <view class="ph-badges">
        <text class="pill pill-brand">点餐</text>
        <text wx:if="{{isSuper}}" class="pill pill-completed">超级用户</text>
        <text wx:elif="{{hasMerchant}}" class="pill pill-cooking">商家已授权</text>
        <text wx:else class="pill pill-soft">仅客户权限</text>
      </view>
    </view>
  </view>

  <view class="section-head">
    <text class="title">账号权限</text>
    <text class="more">由权限自动生成</text>
  </view>

  <view class="card menu-list">
    <view wx:for="{{permissions}}" wx:key="key" class="menu-row">
      <view class="mr-ic {{item.tone}}">{{item.glyph}}</view>
      <view class="mr-main">
        <view class="mr-title">{{item.title}}</view>
        <view class="mr-desc">{{item.desc}}</view>
      </view>
      <text class="pill {{item.granted ? 'pill-completed' : 'pill-hidden'}}">{{item.statusText}}</text>
    </view>
  </view>

  <view wx:if="{{hasMerchant}}" class="manage-entry" bindtap="goManage">
    <view class="me-main">
      <view class="me-title">进入管理</view>
      <view class="me-desc">订单看板、采购清单、菜品与食材{{isSuper ? '，以及用户授权' : ''}}</view>
    </view>
    <view class="chevron right"></view>
  </view>

  <view class="section-head">
    <text class="title">账号与开发</text>
  </view>

  <view class="card menu-list">
    <view class="menu-row">
      <view class="mr-main">
        <view class="mr-title">最近登录</view>
        <view class="mr-desc">同一微信重启后仍是这个账号</view>
      </view>
      <text class="tiny">{{lastLoginText}}</text>
    </view>
    <view class="menu-row" bindtap="editBaseUrl">
      <view class="mr-main">
        <view class="mr-title">接口地址</view>
        <view class="mr-desc">开发期可修改，默认 localhost:3000</view>
      </view>
      <view class="url-value">{{baseUrl}}</view>
    </view>
  </view>

  <view class="about-card">
    <view class="about-title">小张的餐厅 · v1.0</view>
    <view class="about-desc">进入即点餐；商家与超级用户的入口由权限决定，有权限时底部会出现「管理」。本期不含金额、支付、库存、取餐码、桌号、中英文切换和 AI 推荐。</view>
    <view class="about-desc">口味与忌口通过整单备注传达，食材用于生成采购清单。</view>
  </view>
</view>

<tab-bar merchant="{{hasMerchant}}" active="profile" />
