<view class="profile-page page-with-tab">
  <view class="profile-hero">
    <view class="avatar big">{{avatarChar}}</view>
    <view class="ph-main">
      <view class="ph-name">{{user.nickname || '微信用户'}}</view>
      <view class="ph-id">用户 #{{user.id}}<text wx:if="{{openidMasked}}"> · {{openidMasked}}</text></view>
      <view class="ph-badges">
        <text class="pill pill-brand">{{currentRoleTitle}}</text>
        <text wx:if="{{user.isSuper}}" class="pill pill-completed">超级用户</text>
        <text wx:elif="{{user.canMerchant}}" class="pill pill-cooking">商家已授权</text>
        <text wx:else class="pill pill-soft">仅客户视角</text>
      </view>
    </view>
  </view>

  <view class="section-head">
    <text class="title">切换视角</text>
    <text class="more">同一个账号</text>
  </view>

  <view class="role-grid">
    <view
      wx:for="{{roles}}"
      wx:key="key"
      class="role-tile {{item.key === role ? 'on' : ''}}"
      bindtap="switchRole"
      data-key="{{item.key}}"
    >
      <view class="rt-glyph {{item.iconClass}}">{{item.glyph}}</view>
      <view class="rt-title">{{item.shortTitle}}</view>
      <view class="rt-desc">{{item.shortDesc}}</view>
      <view wx:if="{{item.key === role}}" class="rt-current">当前</view>
    </view>
  </view>

  <view class="section-head">
    <text class="title">常用入口</text>
    <text class="more">{{currentRoleTitle}}视角</text>
  </view>

  <view class="card menu-list">
    <view
      wx:for="{{links}}"
      wx:key="key"
      class="menu-row"
      bindtap="openLink"
      data-url="{{item.url}}"
      data-tab="{{item.tab}}"
    >
      <view class="mr-ic {{item.iconClass}}">{{item.glyph}}</view>
      <view class="mr-main">
        <view class="mr-title">{{item.title}}</view>
        <view class="mr-desc">{{item.desc}}</view>
      </view>
      <view class="chevron right"></view>
    </view>
  </view>

  <view class="section-head">
    <text class="title">账号与开发</text>
  </view>

  <view class="card menu-list">
    <view class="menu-row">
      <view class="mr-main">
        <view class="mr-title">最近登录</view>
        <view class="mr-desc">同一微信重启后仍是这个账号</view>
      </view>
      <text class="tiny">{{lastLoginText}}</text>
    </view>
    <view class="menu-row" bindtap="editBaseUrl">
      <view class="mr-main">
        <view class="mr-title">接口地址</view>
        <view class="mr-desc">开发期可修改，默认 localhost:3000</view>
      </view>
      <view class="url-value">{{baseUrl}}</view>
    </view>
  </view>

  <view class="about-card">
    <view class="about-title">小张的餐厅 · v1.0</view>
    <view class="about-desc">本期只做点餐、接单、采购与评价；不含金额、支付、库存、取餐码、桌号、中英文切换和 AI 推荐。</view>
    <view class="about-desc">口味与忌口通过整单备注传达，食材用于生成采购清单。</view>
  </view>
</view>

<tab-bar role="{{role}}" active="profile" />
