.dish-page {
  min-height: 100vh;
  padding-top: 24rpx;
  background: var(--bg);
}

.dish-hero {
  position: relative;
  height: 520rpx;
  margin: 0 24rpx;
  border-radius: var(--r-lg);
  overflow: hidden;
  background: #F2E1D0;
  box-shadow: 0 12rpx 32rpx rgba(92, 62, 42, 0.12);
}

.off-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(58, 48, 42, 0.46);
  color: #FFF8F0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.06em;
}

.sheet {
  position: relative;
  margin: -52rpx 24rpx 0;
  padding: 36rpx 32rpx 34rpx;
  border-radius: var(--r-lg);
  background: var(--surface);
  box-shadow: 0 10rpx 32rpx rgba(92, 62, 42, 0.1);
}

.title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.title-main {
  flex: 1;
  min-width: 0;
}

.dish-title {
  font-size: var(--fs-page);
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: -0.01em;
}

.dish-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.rating-box {
  text-align: right;
  flex: none;
  padding-top: 4rpx;
}

.rating-box.empty {
  padding-top: 10rpx;
}

.rating-num {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--brand-deep);
  line-height: 1.1;
}

.rating-box .stars {
  justify-content: flex-end;
  margin: 6rpx 0 4rpx;
}

.intro {
  margin-top: 22rpx;
  font-size: var(--fs-sub);
  line-height: 1.7;
  color: var(--ink-2);
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid var(--line-2);
}

.block {
  padding-top: 28rpx;
}

.block-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.block-title {
  font-size: 28rpx;
  font-weight: 600;
}

.ing-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.ing-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 20rpx;
  border-radius: var(--r-pill);
  background: var(--search-bg);
  font-size: 23rpx;
  color: var(--ink-2);
}

.ing-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--brand);
  opacity: 0.7;
}

.review-row {
  padding: 18rpx 0;
}

.review-row + .review-row {
  border-top: 1rpx solid var(--line-2);
}

.review-content {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--ink-2);
}

.serving {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 30rpx;
  padding: 24rpx;
  border-radius: var(--r-md);
  background: var(--paper);
  border: 1rpx solid var(--line-2);
}

.serving-main {
  flex: 1;
  min-width: 0;
}

.serving-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}
