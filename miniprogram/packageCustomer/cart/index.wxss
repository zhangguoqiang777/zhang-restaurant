.cart-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 0;
  background: var(--bg);
}

.empty-cart {
  padding-top: 180rpx;
}

.cart-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 6rpx 4rpx 22rpx;
}

.cart-title {
  font-size: var(--fs-block);
  font-weight: 600;
  line-height: 1.3;
}

.clear-link {
  font-size: 22rpx;
  color: var(--ink-3);
  padding: 10rpx 4rpx;
}

.cart-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.cart-item {
  display: flex;
  gap: 22rpx;
  padding: 22rpx;
  border-radius: var(--r-md);
  background: var(--surface);
  border: 1rpx solid var(--line-2);
  box-shadow: 0 4rpx 16rpx rgba(92, 62, 42, 0.05);
}

.cart-art {
  width: 136rpx;
  height: 136rpx;
  border-radius: var(--r-sm);
  overflow: hidden;
  flex: none;
}

.cart-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.cart-name {
  font-size: 28rpx;
  font-weight: 600;
}

.cart-intro {
  margin-top: 6rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: var(--ink-3);
  min-height: 62rpx;
}

.cart-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: auto;
  padding-top: 10rpx;
}

.stepper.sm .step-btn {
  width: 52rpx;
  height: 50rpx;
  font-size: 26rpx;
}

.stepper.sm .step-q {
  width: 48rpx;
  font-size: 24rpx;
}

.remark-card {
  margin-top: 26rpx;
  padding: 26rpx;
}

.remark-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.remark-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.remark-count {
  font-size: 21rpx;
  color: var(--ink-3);
  padding-top: 4rpx;
}

.remark-input {
  width: 100%;
  height: 170rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--r-sm);
  background: var(--field-bg);
  border: 1rpx solid var(--line-2);
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--ink);
}

.cart-bottom {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.cb-sum {
  flex: 1;
  min-width: 0;
}

.cb-count {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.2;
}

.cb-btn {
  flex: none;
  height: 88rpx;
  min-width: 240rpx;
  padding: 0 40rpx;
  border-radius: 44rpx;
  background: var(--brand);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 28rpx rgba(192, 96, 60, 0.24);
}

.cb-btn.disabled {
  background: #D9C8B7;
  box-shadow: none;
}
