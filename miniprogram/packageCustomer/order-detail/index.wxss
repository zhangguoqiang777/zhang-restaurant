.detail-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 0;
  background: var(--bg);
}

.info-card {
  padding: 26rpx;
  margin-bottom: 24rpx;
}

.order-no {
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 2rpx;
}

.kv-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 9rpx 0;
  font-size: 23rpx;
}

.kv-k {
  color: var(--ink-3);
  flex: none;
  width: 130rpx;
}

.kv-v {
  color: var(--ink-2);
  text-align: right;
  flex: 1;
  line-height: 1.55;
}

.item-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
}

.item-row + .item-row {
  border-top: 1rpx solid var(--line-2);
}

.item-art {
  width: 84rpx;
  height: 84rpx;
  border-radius: var(--r-sm);
  overflow: hidden;
  flex: none;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 27rpx;
  font-weight: 500;
}

.item-qty {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand-deep);
  flex: none;
}

.timeline-card {
  padding: 26rpx 28rpx 28rpx;
}
