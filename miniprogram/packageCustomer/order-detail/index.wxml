<view class="detail-page page-with-bottom">
  <view wx:if="{{loading}}" class="loading-line">正在取订单…</view>

  <view wx:elif="{{error}}" class="state-block">
    <view class="state-mark">!</view>
    <view class="state-title">订单没有加载出来</view>
    <view class="state-desc">{{error}}</view>
    <view class="state-action" bindtap="reload">重新加载</view>
  </view>

  <block wx:elif="{{detail}}">
    <view class="state-banner">
      <view class="big">{{detail.bannerGlyph}}</view>
      <view class="sb-main">
        <view class="sb-title">{{detail.bannerTitle}}</view>
        <view class="sb-desc">{{detail.bannerDesc}}</view>
      </view>
      <text class="pill {{detail.pillClass}}">{{detail.statusText}}</text>
    </view>

    <view class="card info-card">
      <view class="between">
        <view>
          <view class="tiny">订单号</view>
          <view class="order-no">#{{detail.id}}</view>
        </view>
        <text class="pill {{detail.pillClass}}">{{detail.statusText}}</text>
      </view>
      <view class="divider"></view>
      <view class="kv-row">
        <text class="kv-k">下单时间</text>
        <text class="kv-v">{{detail.createdText}}</text>
      </view>
      <view class="kv-row">
        <text class="kv-k">用餐方式</text>
        <text class="kv-v">到店自取 · 本期不做取餐码与桌号</text>
      </view>
      <view class="kv-row">
        <text class="kv-k">备注</text>
        <text class="kv-v">{{detail.remark || '无'}}</text>
      </view>
    </view>

    <view class="progress3">
      <view class="pstep done">
        <view class="pdot">1</view>
        <text>已下单</text>
      </view>
      <view class="pline {{detail.line1Class}}"></view>
      <view class="pstep {{detail.step2Class}}">
        <view class="pdot">2</view>
        <text>制作中</text>
      </view>
      <view class="pline {{detail.line2Class}}"></view>
      <view class="pstep {{detail.step3Class}}">
        <view class="pdot">3</view>
        <text>完成</text>
      </view>
    </view>

    <view class="section-head">
      <text class="title">这一单的菜</text>
      <text class="more">共 {{detail.totalQty}} 份</text>
    </view>

    <view class="order-detail-list">
      <view wx:for="{{detail.items}}" wx:key="dishId" class="item-row">
        <view class="item-art">
          <dish-art image-key="{{item.imageKey}}" name="{{item.nameZh}}" />
        </view>
        <view class="item-main">
          <view class="item-name">{{item.nameZh}}</view>
        </view>
        <view class="item-qty">× {{item.qty}}</view>
      </view>
    </view>

    <view class="section-head">
      <text class="title">进度</text>
    </view>

    <view class="card timeline-card">
      <view wx:for="{{detail.timeline}}" wx:key="key" class="tl-item {{item.state}}">
        <view class="tl-dot"></view>
        <view class="tl-body">
          <view class="tl-title">{{item.title}}</view>
          <view class="tl-time">{{item.time}}</view>
        </view>
      </view>
    </view>

    <view class="note-line">
      <view class="note-dot">i</view>
      <text>页面每 30 秒自动刷新一次；商家推进状态后，这里会同步更新。</text>
    </view>
  </block>
</view>

<view class="bottom-bar" wx:if="{{detail}}">
  <view class="btn-row" wx:if="{{detail.status === 'pending'}}">
    <button class="ghost-btn" bindtap="cancel">取消订单</button>
    <button class="brand-btn" bindtap="refresh">刷新状态</button>
  </view>
  <view wx:elif="{{detail.status === 'cooking'}}">
    <button class="ghost-btn" bindtap="refresh">刷新状态</button>
  </view>
  <view class="btn-row" wx:else>
    <button class="ghost-btn" bindtap="goMenu">再点一单</button>
    <button class="brand-btn" bindtap="goReview">{{detail.reviewed ? '查看评价' : '去评价'}}</button>
  </view>
</view>
