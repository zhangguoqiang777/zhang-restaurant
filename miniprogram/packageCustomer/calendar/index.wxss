.cal-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 0;
  background: var(--bg);
}

.cal-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 6rpx 4rpx 20rpx;
}

.cal-head .t-page {
  margin-bottom: 6rpx;
}

.today-btn {
  padding: 12rpx 22rpx;
  border-radius: var(--r-pill);
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-size: 22rpx;
  font-weight: 500;
  flex: none;
}

.cal-card {
  padding: 18rpx 16rpx 16rpx;
}

.month-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 8rpx 14rpx;
}

.month-title {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 0.01em;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-2);
}

.nav-btn:active {
  background: var(--paper);
}

.chevron.left {
  border: none;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(45deg);
}

.chevron.right {
  border: none;
  border-right: 4rpx solid currentColor;
  border-top: 4rpx solid currentColor;
  transform: rotate(45deg);
  width: 16rpx;
  height: 16rpx;
}

.week-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  padding: 4rpx 0 10rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--ink-3);
}

.grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4rpx;
}

.cell {
  height: 98rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  position: relative;
}

.cell.dim .day-num {
  color: #D2C4B6;
}

.cell.today {
  box-shadow: inset 0 0 0 2rpx rgba(192, 96, 60, 0.4);
}

.cell.selected {
  background: var(--brand);
  box-shadow: 0 8rpx 20rpx rgba(192, 96, 60, 0.24);
}

.day-num {
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.2;
}

.cell.selected .day-num {
  color: #FFFFFF;
  font-weight: 600;
}

.dot-row {
  height: 22rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.dot-row.placeholder {
  height: 22rpx;
}

.meal-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--brand);
}

.cell.selected .meal-dot {
  background: #FFFFFF;
}

.dot-num {
  font-size: 17rpx;
  color: var(--brand-deep);
  line-height: 1;
}

.cell.selected .dot-num {
  color: #FFFFFF;
}

.month-tip {
  margin: 10rpx 8rpx 2rpx;
  font-size: 20rpx;
  color: var(--amber);
}

.day-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 32rpx 4rpx 18rpx;
}

.day-title {
  font-size: 32rpx;
  font-weight: 600;
}

.day-error {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 40rpx 0;
  font-size: 23rpx;
  color: var(--rose);
}

.retry-link {
  color: var(--brand-deep);
  text-decoration: underline;
}

.day-empty {
  padding: 56rpx 24rpx;
}

.meal-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  margin-bottom: 18rpx;
}

.meal-art {
  width: 104rpx;
  height: 104rpx;
  border-radius: var(--r-sm);
  overflow: hidden;
  flex: none;
}

.meal-main {
  flex: 1;
  min-width: 0;
}

.meal-title {
  font-size: 27rpx;
  font-weight: 600;
}

.meal-sub {
  margin-top: 5rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}

.meal-tags {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
}

.meal-arrow {
  flex: none;
  color: var(--ink-3);
  padding-right: 6rpx;
}
