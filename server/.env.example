# 服务端口
PORT=3000
HOST=0.0.0.0

# 数据库文件与图片目录（相对路径以 server/ 为基准）
DB_FILE=./data/restaurant.db
UPLOAD_DIR=./uploads

# JWT 签名密钥，上线必须替换为随机长字符串
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=30d

# 微信小程序凭证；WECHAT_MOCK=1 时跳过真实 code2session
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_MOCK=1

# 生成图片绝对地址用的公网地址；留空则按请求 Host 拼接
PUBLIC_BASE_URL=
